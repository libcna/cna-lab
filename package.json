{
  "name": "cna-ts-template",
  "version": "0.1.0",
  "description": "Canonical truthful TypeScript and JavaScript project template for CNA-TS",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "check": "tsc -p tsconfig.json",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "create:typescript": "node tools/create-project.mjs --language typescript --output generated/typescript",
    "create:javascript": "node tools/create-project.mjs --language javascript --output generated/javascript",
    "verify:generated": "node tools/verify-generated.mjs",
    "smoke:native": "node tools/native-smoke.mjs"
  },
  "dependencies": {
    "cna-ts": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false
}
